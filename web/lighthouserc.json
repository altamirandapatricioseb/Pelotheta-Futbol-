{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start -p 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/equipo",
        "http://localhost:3100/jugadores",
        "http://localhost:3100/situaciones",
        "http://localhost:3100/estadistica/goles?entidad=jugador&id=6"
      ],
      "numberOfRuns": 2,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["error", { "minScore": 0.45 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "dom-size": ["warn", { "maxNumericValue": 4000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
